{
  "name": "biosim4-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "React SPA driving the biosim4-wasm simulator",
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:wasm:debug": "node scripts/build-wasm.mjs --dev",
    "watch:wasm": "node scripts/build-wasm.mjs --watch",
    "dev": "npm run build:wasm:debug && vite",
    "build": "npm run build:wasm && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist pkg node_modules/.vite"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.55.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
